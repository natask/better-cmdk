{
  "name": "master-cmdk-semantic",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Client-side semantic scoring helpers for master-cmdk.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "potion-score": "./dist/potion-cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js"
    },
    "./potion": {
      "types": "./dist/potion.d.ts",
      "import": "./dist/potion.mjs",
      "require": "./dist/potion.js"
    },
    "./qwen": {
      "types": "./dist/qwen.d.ts",
      "import": "./dist/qwen.mjs",
      "require": "./dist/qwen.js"
    },
    "./embedding": {
      "types": "./dist/embedding.d.ts",
      "import": "./dist/embedding.mjs",
      "require": "./dist/embedding.js"
    },
    "./huggingface": {
      "types": "./dist/huggingface.d.ts",
      "import": "./dist/huggingface.mjs",
      "require": "./dist/huggingface.js"
    }
  },
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "potion:score": "node dist/potion-cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.15",
    "master-cmdk-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "sideEffects": false,
  "keywords": [
    "cmdk",
    "command",
    "palette",
    "search",
    "semantic",
    "vectors"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natask/master-cmdk.git",
    "directory": "packages/master-cmdk-semantic"
  }
}
